{
  "compilerOptions": {
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "target": "ESNext",
    "declaration": false,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "composite": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": false,
    "paths": {
      "@/*": ["./src/main/*"],
      "~common/*": ["./src/common/*"],
      "*": ["./*"]
    }
  },
  "include": [
    "../../src/libs/mcp/__tests__/fixtures/negotiationServers.ts",
    "src/main/**/*",
    "src/main/global.d.ts",
    "src/preload/**/*",
    "src/common/**/*",
    "electron-builder.js",
    "native-deps.config.js"
  ]
}
